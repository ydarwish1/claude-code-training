{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel)}/.claude/hooks/pre-push-check.sh\"",
            "timeout": 180,
            "statusMessage": "Running tests and build before push..."
          }
        ]
      }
    ]
  }
}
